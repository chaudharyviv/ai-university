# --- LLM Providers ---
# You have both keys, so LiteLLM can route between them (see config.py).
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# --- Model defaults ---
# gpt-4o-mini as primary while iterating through phases - cheap and fast.
# Swap to an Anthropic model (e.g. anthropic/claude-sonnet-4-6) for the
# final quality pass once all phases are built.
PRIMARY_MODEL=openai/gpt-4o-mini
FALLBACK_MODEL=anthropic/claude-sonnet-4-6
# Reviewer uses a different model than the generator on purpose - see
# config.py. Keep this distinct from PRIMARY_MODEL.
REVIEWER_MODEL=anthropic/claude-haiku-4-5

# Max output tokens per agent call. 4000 covers the most verbose agents
# (notebook, research) with headroom; short agents just won't use it all.
MAX_TOKENS=4000

# --- App settings ---
APP_ENV=development          # development | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
WORKSPACE_DIR=./workspace     # per-run scratch directory
OUTPUTS_DIR=./outputs         # final exported artifacts

# --- Database ---
# SQLite for local dev; swap for a Postgres URL later without code changes.
DATABASE_URL=sqlite:///./ai_university.db

# --- Search tool (Tavily) ---
TAVILY_API_KEY=your-tavily-key-here

# --- Cost tracking ---
# Soft budget ceiling per run, in USD. Orchestrator can warn/stop past this.
MAX_COST_PER_RUN_USD=2.00

# --- Phase 4: Reviewer loop ---
# Each reviewable content agent (notebook/code/diagram/quiz/assignment/
# speaker_notes) gets reviewed and, if rejected, re-run with feedback up
# to this many times before its last output is accepted as-is.
# Adds ~1 extra LLM call per reviewable agent (more on rejections) - set
# ENABLE_REVIEW=false to skip the loop entirely and cut that cost.
ENABLE_REVIEW=true
REVIEW_MAX_ATTEMPTS=2

